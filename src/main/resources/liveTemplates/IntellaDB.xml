<?xml version="1.0" encoding="UTF-8"?>
<!-- The SQL statement templates, in IntelliJ database-tools tradition: sel/selw/selc/lim,
     ins/upd/del, tab/view/col. Variables open completion where a schema object belongs. -->
<templateSet group="Intella DB">
  <template name="sel" value="select * from $table$$END$;" description="select everything from a table"
            toReformat="true">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="selw" value="select * from $table$ $alias$ where $alias$.$END$;"
            description="select everything from a table with a where clause" toReformat="true">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="alias" expression="complete()" defaultValue="&quot;t&quot;" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="selc" value="select count(*) from $table$$END$;" description="count a table's rows"
            toReformat="true">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="lim" value="select * from $table$ limit $size$$END$;" description="select the first rows of a table"
            toReformat="true">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="size" expression="" defaultValue="100" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="ins" value="insert into $table$ ($columns$) values ($info$$END$);"
            description="insert a row into a table" toReformat="true">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="columns" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="info" expression="showParameterInfo()" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="upd" value="update $table_name$ set $col$ = $value$ where $END$;"
            description="update rows of a table" toReformat="true">
    <variable name="table_name" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="col" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <variable name="value" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="del" value="delete from $table$ where $END$;" description="delete rows of a table"
            toReformat="true">
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="tab" value="create table $table$ (&#10;  $col$ $type$ $null$$END$&#10;);"
            description="new table definition" toReformat="true">
    <variable name="table" expression="" defaultValue="&quot;new_table&quot;" alwaysStopAt="true"/>
    <variable name="col" expression="" defaultValue="&quot;id&quot;" alwaysStopAt="true"/>
    <variable name="type" expression="complete()" defaultValue="&quot;bigint&quot;" alwaysStopAt="true"/>
    <variable name="null" expression="" defaultValue="&quot;not null&quot;" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="view" value="create view $view$ as select * from $table$ $END$;"
            description="new view definition" toReformat="true">
    <variable name="view" expression="" defaultValue="&quot;new_view&quot;" alwaysStopAt="true"/>
    <variable name="table" expression="complete()" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
  <template name="col" value="$col$ $type$ $null$$END$" description="new column definition"
            toReformat="true">
    <variable name="col" expression="" defaultValue="&quot;col&quot;" alwaysStopAt="true"/>
    <variable name="type" expression="complete()" defaultValue="&quot;int&quot;" alwaysStopAt="true"/>
    <variable name="null" expression="" defaultValue="&quot;not null&quot;" alwaysStopAt="true"/>
    <context>
      <option name="INTELLA_SQL" value="true"/>
    </context>
  </template>
</templateSet>

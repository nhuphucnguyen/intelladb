<idea-plugin>
    <id>community.intelladb</id>
    <name>Intella DB</name>
    <vendor>community</vendor>
    <description><![CDATA[
    A lightweight database client for <b>IntelliJ IDEA Community</b>: manage PostgreSQL connections,
    browse schemas/tables/columns, preview table data, run SQL in a console with a results grid,
    and ask an AI assistant about your database in natural language (NL → SQL).
    <br><br>
    The AI assistant is provider-agnostic: any OpenAI-compatible endpoint works — Z.ai GLM coding plan,
    OpenAI, DeepSeek, OpenRouter, or a local Ollama. Your API key is stored in the IDE's secure
    credential store.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DB Explorer" anchor="right" canCloseContents="false"
                    factoryClass="community.intelladb.ui.DbToolWindowFactory"/>

        <!-- Console output + result sets, like IntelliJ's Services view for database consoles -->
        <toolWindow id="DB Services" anchor="bottom" canCloseContents="false"
                    icon="AllIcons.Toolwindows.ToolWindowServices"
                    factoryClass="community.intelladb.ui.DbServicesToolWindowFactory"/>

        <fileEditorProvider implementation="community.intelladb.ui.IntellaDbFileEditorProvider"/>

        <!-- SQL console tabs: "console [@name]" title and console icon -->
        <editorTabTitleProvider implementation="community.intelladb.ui.ConsoleFilePresentation"/>
        <fileIconProvider implementation="community.intelladb.ui.ConsoleFilePresentation"/>

        <applicationService serviceImplementation="community.intelladb.ai.AiSettings"/>

        <applicationConfigurable parentId="tools"
                                 id="community.intelladb.ai.provider"
                                 displayName="Intella DB — AI Provider"
                                 instance="community.intelladb.settings.AiProviderConfigurable"/>

        <notificationGroup id="IntellaDB" displayType="BALLOON"/>

        <!-- Liquibase: SQL highlighting inside <sql> elements of XML changelogs -->
        <languageInjector implementation="community.intelladb.liquibase.LiquibaseSqlInjector"/>

        <!-- IntellaSQL fallback language (highlighting for injected SQL when no platform SQL language) -->
        <lang.syntaxHighlighterFactory language="IntellaSQL"
                                       implementationClass="community.intelladb.sql.IntellaSqlSyntaxHighlighter$Factory"/>
        <lang.parserDefinition language="IntellaSQL"
                               implementationClass="community.intelladb.sql.IntellaSqlParserDefinition"/>

        <!-- INSERT column <-> value aid (caret highlighting + inline column hints) -->
        <postStartupActivity implementation="community.intelladb.sql.SqlColumnValueAidStartup"/>
    </extensions>

    <projectListeners>
        <!-- installs the console header toolbar whenever a console tab (re)opens -->
        <listener class="community.intelladb.ui.ConsoleFilePresentation"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
